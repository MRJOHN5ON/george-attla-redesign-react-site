  "contentHtml": "<figure class=\"post-image tf_clearfix\">\n\t\t\t    \t\t\t\t\t\t\t\t<a href=\"/dogs-of-speed\">\n\t\t\t\t\t\t\t\t<img src=\"/images/attla/2011/12/thumb-speedakmag2.jpg\" class=\"wp-post-image wp-image-462 attla-content-img\" title=\"Speed Racers\" alt=\"Speed Racers\">\t\t\t\t\t\t\t\t    \t\t\t\t</a>\n\t\t\t\t\t\t\t    \t\t\t</figure>\n\t\t\t\n\t<div class=\"post-content\">\n\n\t\t\t\t\t<time datetime=\"2012-05-27\" class=\"post-date entry-date updated\">May 27, 2012</time>\n\n\t\t\n\t\t\t\t\t<h1 class=\"post-title entry-title\"><a href=\"/dogs-of-speed\">Dogs of Speed</a></h1>\t\t\n\t\t\t\t\t<p class=\"post-meta entry-meta\">\n\t\t\t\t\t\t\t\t\t<span class=\"post-author\"><span class=\"author vcard\"><a class=\"url fn n\" href=\"/author/kathy\" rel=\"author\">kathy</a></span></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"post-category\"><a href=\"/category/highlight\" rel=\"category tag\">highlight</a>, <a href=\"/category/main\" rel=\"category tag\">main</a></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\n\t\t\t<div class=\"entry-content\">\n\n        \t\t\t\t<!--themify_builder_content-->\n<div id=\"themify_builder_content-217\" data-postid=\"217\" class=\"themify_builder_content themify_builder_content-217 themify_builder tf_clear\">\n    \t<!-- module_row -->\n\t<div data-lazy=\"1\" class=\"module_row themify_builder_row tb_yobt509 tb_first tf_clearfix\">\n\t    \t\t<div class=\"row_inner col_align_top col-count-2 tf_box tf_w tf_rel\">\n\t\t\t<div data-lazy=\"1\" class=\"module_column tb-column col4-2 first tb_17ql510 tf_box\">\n\t\t\t    \t        <div class=\"tb-column-inner tf_box tf_w\">\n\t\t    <!-- module text -->\n<div class=\"module module-text tb_s6ok623   \" data-lazy=\"1\">\n        <div class=\"tb_text_wrap\">\n    <p>&nbsp;</p>\n<p class=\"has-text-align-left\"><strong>Speed Racers </strong>&nbsp;<strong>Lighter, Faster</strong>&nbsp;<strong>Sprint Dogs</strong>&nbsp;<strong>Thrill Mushers</strong>&nbsp;<strong>and Fans</strong></p>\n<p>Long ago sprint racing was the sport that&nbsp;grabbed Alaska’s attention each winter. &nbsp;The&nbsp;racing is all about speed. Though over shadowed&nbsp;by the national popularity of the thousand-mile&nbsp;Iditarod race, sprint racing appears to be making&nbsp;a comeback all over the State with a new&nbsp;breed of dog and musher.</p>\n<p><a href=\"/files/attla/2011/12/2011.03.29-AKMAG-Speed_Comp-Rev-cover-foreword_Small_RJ.pdf\">March 2011 Alaska Magazine – Speed Racers (PDF 18MB)</a></p>\n<p><em style=\"caret-color: #000000; color: #000000;\">Excited and hardworking dogs running the Fur Rendezvous World Championship. Photo courtesy of AlaskaMagazine. Dogs owned by Buddy Streeper.</em></p>    </div>\n</div>\n<!-- /module text -->\t        </div>\n\t    \t</div>\n\t\t<div data-lazy=\"1\" class=\"module_column tb-column col4-2 last tb_w11p121 tf_box\">\n\t\t\t    \t        <div class=\"tb-column-inner tf_box tf_w\">\n\t\t    <!-- module image -->\n<div class=\"module module-image tb_o3cf613   image-top tf_mw\" data-lazy=\"1\">\n        <div class=\"image-wrap tf_rel tf_mw\">\n\t\t    <a href=\"/files/attla/2011/12/2011.03.29-AKMAG-Speed_Comp-Rev-cover-foreword_Small_RJ.pdf\">\n\t\t   \t\t<img src=\"/images/attla/2011/12/speedracersspread.jpg\" class=\"wp-post-image wp-image-553 attla-content-img\" title=\"Speed Racers Alaska Magazine\" alt=\"Speed Racers Alaska Magazine\">\t    </a>\n\t\n\t\t</div>\n\t<!-- /image-wrap -->\n    \n    \t</div>\n<!-- /module image -->\t        </div>\n\t    \t</div>\n\t\t    </div>\n\t    <!-- /row_inner -->\n\t</div>\n\t<!-- /module_row -->\n\t</div>\n<!--/themify_builder_content-->\n\t    \n\t</div><!-- /.entry-content -->\n\t\n\t</div>\n\t<!-- /.post-content -->"
